// pdigital database schema.
// Money is stored as integers in agorot (1 ILS = 100) to avoid rounding errors.
// Card details are NEVER stored - only the payment provider's transaction reference.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Admin users

enum AdminRole {
  OWNER   // everything, including users and business settings
  MANAGER // products, orders, content, coupons
  EDITOR  // content only
}

model AdminUser {
  id                 String         @id @default(cuid())
  username           String         @unique
  email              String?        @unique // for password reset
  passwordHash       String
  displayName        String
  role               AdminRole      @default(EDITOR)
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  twoFactorSecret    String? // for 2FA, added later
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  sessions           AdminSession[]
  auditLogs          AuditLog[]
  resetTokens        PasswordResetToken[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// Only a SHA-256 hash of the session token is stored; the raw token lives in an httpOnly cookie.
model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
}

// One-time password reset links. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

// Rate limiting for login attempts per IP
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  username  String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------- Catalog

model Category {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  description    String?
  imageUrl       String?
  // Accessories live in a child category with isAccessories = true
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  isAccessories  Boolean    @default(false)
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  showOnHome     Boolean    @default(true) // "המחלקות שלנו"
  seoTitle       String?
  seoDescription String?
  products       Product[]
  menuItems      MenuItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  logoUrl          String?
  showInBrandStrip Boolean   @default(false)
  sortOrder        Int       @default(0)
  leadTimeDays     Int? // days from ordering to stock in store; overrides the default for reorder alerts
  products         Product[]
}

// A product type (e.g. "מטען", "אוזניות") defines which spec fields its products share,
// so every card in a category shows the same fields and filters can be built from them.
model ProductType {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  specFields SpecField[]
  products   Product[]
}

enum SpecFieldKind {
  TEXT
  NUMBER
  BOOLEAN
}

model SpecField {
  id            String             @id @default(cuid())
  productTypeId String
  productType   ProductType        @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  key           String
  label         String
  unit          String? // e.g. "W", "mAh"
  kind          SpecFieldKind      @default(TEXT)
  group         String? // collapsible section on the product page
  isFilterable  Boolean            @default(false)
  showOnCard    Boolean            @default(false)
  sortOrder     Int                @default(0)
  values        ProductSpecValue[]

  @@unique([productTypeId, key])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductTag {
  NEW  // חדש
  SALE // מבצע
  HOT  // להיט
}

model Product {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  shortDescription String?
  description      String?
  status           ProductStatus      @default(DRAFT)
  tags             ProductTag[]
  categoryId       String
  category         Category           @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?             @relation(fields: [brandId], references: [id])
  supplierId       String?
  supplier         Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  productTypeId    String?
  productType      ProductType?       @relation(fields: [productTypeId], references: [id])
  warrantyMonths   Int?
  isWeeklyDeal     Boolean            @default(false) // "מבצעי השבוע"
  noReorder        Boolean            @default(false) // exclude from reorder alerts (seasonal / discontinued)
  inGoogleShopping Boolean            @default(true) // include in the Google Shopping product feed
  seoTitle         String?
  seoDescription   String?
  images           ProductImage[]
  variants         ProductVariant[]
  specValues       ProductSpecValue[]
  accessories      ProductAccessory[] @relation("ProductAccessories")
  accessoryOf      ProductAccessory[] @relation("AccessoryOf")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([categoryId, status])
  @@index([brandId])
  @@index([supplierId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String // required for accessibility
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String      @unique
  barcode           String?
  name              String? // e.g. "שחור / 128GB"; null when the product has a single variant
  options           Json? // e.g. {"צבע": "שחור", "נפח": "128GB"}
  price             Int // agorot
  compareAtPrice    Int? // original price when on sale, agorot
  costPrice         Int? // purchase cost per unit, agorot - admin only, for inventory valuation
  stock             Int         @default(0)
  lowStockThreshold Int         @default(3)
  isActive          Boolean     @default(true)
  sortOrder         Int         @default(0)
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  purchaseItems     PurchaseOrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([productId])
}

enum StockReason {
  ONLINE_SALE     // נמכר באתר
  STORE_SALE      // נמכר בחנות
  RESTOCK         // הגיעה סחורה
  ADJUSTMENT      // תיקון ידני
  RETURN          // החזרה
  ORDER_CANCELLED // הזמנה בוטלה
}

// Every change to a variant's stock is recorded here (who, when, why, and the stock after it).
model StockMovement {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change     Int
  stockAfter Int
  reason     StockReason
  note       String?
  orderId    String?
  unitPrice  Int? // store sales: selling price per unit when sold (agorot, incl. VAT)
  unitCost   Int? // store sales: purchase cost per unit when sold (agorot, before VAT)
  userId     String?
  user       AdminUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
}

model ProductSpecValue {
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  specFieldId String
  specField   SpecField @relation(fields: [specFieldId], references: [id], onDelete: Cascade)
  value       String

  @@id([productId, specFieldId])
  @@index([specFieldId, value])
}

model ProductAccessory {
  productId   String
  product     Product @relation("ProductAccessories", fields: [productId], references: [id], onDelete: Cascade)
  accessoryId String
  accessory   Product @relation("AccessoryOf", fields: [accessoryId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)

  @@id([productId, accessoryId])
}

// ---------------------------------------------------------------- Customers

model Customer {
  id               String    @id @default(cuid())
  email            String    @unique
  phone            String?
  firstName        String
  lastName         String
  passwordHash     String? // null = guest checkout only
  marketingConsent Boolean   @default(false)
  // Proof of consent for advertising messages (Israeli anti-spam law): when, where, and opt-out.
  consentAt        DateTime?
  consentSource    String? // "קופה" / "צור קשר" / "ידני"
  unsubscribedAt   DateTime?
  unsubToken       String    @unique @default(cuid()) // for the one-click "remove me" link in emails
  isClubMember     Boolean   @default(false)
  addresses        Address[]
  orders           Order[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  city        String
  street      String
  houseNumber String
  apartment   String?
  zipCode     String?
  notes       String?
  isDefault   Boolean  @default(false)

  @@index([customerId])
}

// ---------------------------------------------------------------- Orders

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement())
  status          OrderStatus @default(PENDING_PAYMENT)
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])

  // Snapshot of contact & shipping details at the time of the order
  email           String
  phone           String
  firstName       String
  lastName        String
  city            String
  street          String
  houseNumber     String
  apartment       String?
  zipCode         String?
  deliveryNotes   String?
  shippingMethod  String
  companyName     String? // invoice for a business
  companyTaxId    String? // ח.פ / ע.מ
  publicToken     String      @unique @default(cuid()) // for the customer's order confirmation link
  stockDeducted   Boolean     @default(false) // stock is taken only once the order is paid

  subtotal        Int // agorot
  discountTotal   Int         @default(0)
  shippingTotal   Int         @default(0)
  total           Int
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])

  // Payment provider reference only - never card data
  paymentProvider String?
  paymentRef      String?
  paidAt          DateTime?

  invoiceNumber   String?
  invoiceUrl      String?
  trackingNumber  String?
  internalNotes   String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshot so the order stays correct if the product changes later
  productName String
  variantName String?
  sku         String
  unitPrice   Int // agorot
  quantity    Int
  lineTotal   Int
  unitCost    Int? // purchase cost per unit (before VAT) when ordered - admin only, for profit reports

  @@index([orderId])
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int        @default(0) // percent (0-100) or agorot
  minOrderTotal Int? // agorot
  maxUses       Int?
  usedCount     Int        @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean    @default(true)
  orders        Order[]
  createdAt     DateTime   @default(now())
}

// ---------------------------------------------------------------- Site content (editable from admin)

enum BannerPlacement {
  HOME_HERO
  HOME_SIDE // the two small banners
  HOME_CLUB // customer club banner
  CATEGORY_TOP
}

model Banner {
  id             String          @id @default(cuid())
  placement      BannerPlacement
  title          String?
  subtitle       String?
  buttonText     String?
  linkUrl        String?
  imageUrl       String
  mobileImageUrl String?
  alt            String
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive])
}

// Flexible blocks for home page sections, announcement bar, trust strip etc.
// `key` identifies the slot (e.g. "home.shippingBar"), `data` holds its editable fields.
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String // name shown in the admin
  data      Json
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Content pages: terms, accessibility statement, shipping & returns, about
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Blog / articles ("מאמרים") - important for Google ranking
model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  body           String
  coverImageUrl  String?
  coverImageAlt  String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model MenuItem {
  id         String     @id @default(cuid())
  label      String
  url        String?
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[] @relation("MenuTree")
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  HANDLED
}

// Messages sent from the "צור קשר" page
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String
  status    ContactStatus @default(NEW)
  adminNote String?
  ip        String?
  handledAt DateTime?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

// Promotional email sends (history)
model Campaign {
  id         String    @id @default(cuid())
  subject    String
  body       String
  audience   String // description of the filter used, e.g. "כל הרשימה" / "קנו בגיימינג"
  recipients Int       @default(0)
  sent       Int       @default(0)
  failed     Int       @default(0)
  userId     String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

// Business details & global settings (name, phone, WhatsApp, address, hours,
// free shipping threshold...). One row per key, value is JSON.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- purchasing

/// A supplier the store buys stock from.
model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  taxId          String? // ח.פ / ע.מ
  notes          String?
  leadTimeDays   Int? // days from ordering to stock in store; used by reorder alerts
  isActive       Boolean         @default(true)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum PurchaseOrderStatus {
  DRAFT     // טיוטה
  SENT      // נשלחה לספק
  PARTIAL   // התקבלה חלקית
  RECEIVED  // התקבלה במלואה
  CANCELLED // בוטלה
}

/// A purchase order to a supplier. Receiving goods adds the quantities to stock.
model PurchaseOrder {
  id          String              @id @default(cuid())
  number      Int                 @unique @default(autoincrement())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  expectedAt  DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?
  invoiceNos  String? // supplier invoice numbers the goods arrived with, e.g. "1234, 1250"
  createdById String?
  createdBy   AdminUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId])
  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id              String          @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name            String // product name when ordered (kept if the product is deleted)
  sku             String?
  qty             Int
  receivedQty     Int             @default(0)
  unitCost        Int             @default(0) // agorot per unit, before VAT
  isNew           Boolean         @default(false) // product not on the site yet: created when it arrives and is priced
  pricedAt        DateTime? // when a new product was priced and added to the site
  sortOrder       Int             @default(0)

  @@index([purchaseOrderId])
  @@index([variantId])
}

// ---------------------------------------------------------------- statistics

/// One page view on the storefront. Privacy-friendly: no cookies, no IP stored.
/// `visitor` is a one-way hash of IP + browser + the day, so the same person is
/// counted once per day and cannot be followed from one day to the next.
model PageView {
  id        String   @id @default(cuid())
  path      String
  visitor   String
  referrer  String? // site the visitor came from (host only), null = direct
  device    String // "mobile" | "desktop"
  createdAt DateTime @default(now())

  @@index([createdAt])
}
