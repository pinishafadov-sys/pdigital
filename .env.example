# Connection string from Neon (Dashboard -> Connect). Starts with postgresql://
DATABASE_URL=""

# Public site address, e.g. https://www.example.co.il
SITE_URL="http://localhost:3000"

# Email sending (password reset, later order emails) via https://resend.com
# Without these, on localhost the reset link is printed in the server log instead.
RESEND_API_KEY=""
EMAIL_FROM=""   # e.g. "pdigital <noreply@your-domain.co.il>"

# Initial admin account created by `npm run db:seed` (must be changed on first login)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""
